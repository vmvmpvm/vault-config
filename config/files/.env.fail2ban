# vim: syntax=ini
### FAIL2BAN VARIABLES ###

F2B_DB_PURGE_AGE=30d
F2B_LOG_LEVEL=INFO
F2B_IPTABLES_CHAIN=INPUT
SSMTP_HOST=${SMTP_HOST}
SSMTP_PORT=${SMTP_PORT}
SSMTP_USER=${SMTP_USERNAME}
SSMTP_PASSWORD=${SMTP_PASSWORD}
SSMTP_HOSTNAME=Vaultwarden (${DOMAIN})
SSMTP_TLS=YES
SSMTP_STARTTLS=YES

TZ=${TZ}
