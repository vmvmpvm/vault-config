[DEFAULT]
bantime = 6h
findtime = 6h
maxretry = 5
# To enable email alerts, uncomment `destemail` and `sender` below,
# enter your destination and sender emails in the fields,
# and uncomment the `action_mwl` action in the jails below.
%% destemail, sender and sendername are filled in from common.env (fail2ban_email_*);
%% they replace the three commented examples that used to sit here.
destemail = ${fail2ban_email_recipient}
sender = ${fail2ban_email_sender}
sendername = ${fail2ban_email_sendername}

[vaultwarden]
enabled = true
port = 80,443,8081
filter = vaultwarden
logpath = /vaultwarden/vaultwarden*.log
action = cloudflare-iplist
         %(mta)s-whois-lines[sender="%(sender)s", dest="%(destemail)s", logpath="%(logpath)s", chain="%(chain)s"]

[vaultwarden-2fa-failures]
enabled = true
port = 80,443,8081
filter = vaultwarden-2fa-failures
logpath = /vaultwarden/vaultwarden*.log
action = cloudflare-iplist
         %(mta)s-whois-lines[sender="%(sender)s", dest="%(destemail)s", logpath="%(logpath)s", chain="%(chain)s"]

[vaultwarden-admin]
enabled = true
port = 80,443
filter = vaultwarden-admin
logpath = /vaultwarden/vaultwarden*.log
action = cloudflare-iplist
         %(mta)s-whois-lines[sender="%(sender)s", dest="%(destemail)s", logpath="%(logpath)s", chain="%(chain)s"]
