# Shared inputs, defined once. Any file under config/files/ can use them as ${NAME}.
#
#   KEY=value                  plain value
#   KEY=                       intentionally blank (allowed, renders as an empty value)
#   KEY=__FILL_ME__            not filled in yet: the build FAILS if anything uses it
#   KEY=${secrets.NAME}        value comes from the GitHub repository secret NAME
#   KEY=https://${A}/${B}      may reference other keys here (any order, no cycles)
#
# One KEY=VALUE per line, no quotes, no trailing comments. See config/README.md.

# --- Container user (compose substitutes these) ---
ContainerUID=5000
ContainerGID=5000

# --- Host / VM (used by cloud-config.yaml) ---
dockremapUIDRangeStart=165536
dockremapGIDRangeStart=165536
GCPTimeZone=US/Eastern
InteractiveDockerUser=me_mpvbrao_com
TZ=America/New_York

# --- Git identity (gitconfig.sh) ---
GitHubUserEmailId=1680742+vmvmpvm@users.noreply.github.com
GitHubUserFullName=Veer Murukutla

# --- Vaultwarden ---
DOMAIN=vyuham.mpvbrao.com
APP_PATH=vakramu

# --- SMTP (shared by vaultwarden, egress-proxy and fail2ban) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_VAULTWARDEN_FROM_ID=vaultwarden
SMTP_FROM_DOMAIN=vault.mpvbrao.com
SMTP_USERNAME=vaultwarden.fail2ban@mpvbrao.com
SMTP_PASSWORD=${secrets.SMTP_PASSWORD}

# --- fail2ban ---
fail2ban_email_recipient=v.vaultwarden@mpvbrao.com
fail2ban_email_sender=fail2ban@vault.mpvbrao.com
fail2ban_email_sendername=Vaultwarden Fail2ban

# --- Cloudflare ---
cf_account_identifier=449de945cc4cb5a45a2ef95d88f461db
cf_list_id=91d4198229b24a51a5cfa8b8d78a379f
