# vim: syntax=ini
%% Only settings that differ from Vaultwarden's defaults are listed.

# Client IP header (default: X-Real-IP)
IP_HEADER=X-Forwarded-For

# Websocket notifications
WEBSOCKET_ENABLED=true

# Icons are redirected by cloudflare rules (default: false)
DISABLE_ICON_DOWNLOAD=true

# New users only via whitelisted domains or invitation (default: true)
SIGNUPS_ALLOWED=false

# New users must verify their email address (default: false)
SIGNUPS_VERIFY=true


SIGNUPS_DOMAINS_WHITELIST=${SIGNUPS_DOMAINS_WHITELIST}

SHOW_PASSWORD_HINT=false

DOMAIN=https://${DOMAIN}/${APP_PATH}

_ENABLE_DUO=true
DUO_IKEY=DIUJPAN76VGSEYPVOB3P
DUO_SKEY=${secrets.DUO_SKEY}
DUO_HOST=api-f5fbcbd9.duosecurity.com

# Mail
SMTP_HOST=${SMTP_HOST}
SMTP_FROM=${SMTP_VAULTWARDEN_FROM_ID}@${SMTP_FROM_DOMAIN}
SMTP_FROM_NAME=Vaultwarden (${DOMAIN})
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}

TZ=${TZ}

HIBP_API_KEY=${secrets.HIBP_API_KEY}

# Outbound traffic goes through the egress proxy, which has a private IP
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=false

# Enable Bitwarden Push Notification Service
PUSH_ENABLED=true
PUSH_INSTALLATION_ID=${BITWARDEN_PUSH_INSTALLATION_ID}
PUSH_INSTALLATION_KEY=${secrets.BITWARDEN_PUSH_INSTALLATION_KEY}
